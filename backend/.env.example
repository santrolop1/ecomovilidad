# Copia como backend/.env para ejecutar la API fuera de Docker.
# Usa la misma clave que POSTGRES_PASSWORD en el .env de la raíz.
DATABASE_URL=postgresql+psycopg://ecomovilidad:CAMBIAR@localhost:5433/ecomovilidad
CORS_ORIGINS=["http://localhost:3000"]
# true en producción (cookies solo por HTTPS)
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# development: el enlace de recuperación de contraseña se escribe en el log (no hay proveedor de correo)
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
# Debe coincidir con src/config/legal.ts
PRIVACY_POLICY_VERSION=2026-10-06
# CIDR de los proxies cuyo X-Forwarded-For se acepta (el servidor de Next.js)
TRUSTED_PROXIES=["127.0.0.1/32"]

# Pasarela: auto = Wompi si están sus 4 llaves; si no, en desarrollo, la pasarela de pruebas (sin cobro real).
PAYMENT_PROVIDER=auto
# Pagos con Wompi (llaves del panel de comercios). NUNCA las subas a Git.
# Pruebas: pub_test_… prv_test_… test_events_… test_integrity_…
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
# Sandbox; en producción https://production.wompi.co/v1
WOMPI_API_URL=https://sandbox.wompi.co/v1
PAYMENT_WINDOW_MINUTES=30
# Facturación (sin resolución DIAN)
INVOICE_PREFIX=EMV
INVOICE_VAT_PERCENT=19
COMPANY_NIT=
