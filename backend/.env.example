# Copia como backend/.env para ejecutar la API fuera de Docker.
DATABASE_URL=postgresql+psycopg://ecomovilidad:CAMBIAR@localhost:5433/ecomovilidad
CORS_ORIGINS=["http://localhost:3000"]
# true en producción (cookies solo por HTTPS)
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# development: el enlace de recuperación de contraseña se escribe en el log (no hay proveedor de correo)
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
# Debe coincidir con src/config/legal.ts
PRIVACY_POLICY_VERSION=2026-10-06
# CIDR de los proxies cuyo X-Forwarded-For se acepta (el servidor de Next.js)
TRUSTED_PROXIES=["127.0.0.1/32"]
