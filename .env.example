# ── Públicas (se incrustan en el navegador: NUNCA secretos aquí) ──────────────
# URL canónica del sitio (sitemap, canonical, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Maps JavaScript API. Opcional: sin ella se muestra el mapa esquemático.
# Es pública por diseño; restríngela por dominio (HTTP referrer) en Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Servidor de Next.js (no llegan al navegador) ─────────────────────────────
# mock = datos de demostración en memoria · real = FastAPI + PostgreSQL/PostGIS
API_MODE=mock
# Obligatoria con API_MODE=real. Incluye el prefijo de versión.
API_BASE_URL=http://localhost:8000/api/v1
# Latencia artificial del mock en ms (para revisar estados de carga).
MOCK_LATENCY_MS=0
