# Portal web (Next.js) para producción.
# La compilación se hace al arrancar y no al construir la imagen: las páginas de
# producto se generan con los datos reales de la API, que solo existe en ejecución.
FROM node:22-slim

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN chown -R node:node /app
USER node

EXPOSE 3000
CMD ["sh", "-c", "npm run build && npm run start -- -H 0.0.0.0 -p 3000"]
