erDiagram
    accTitle: Modelo de datos / DER completo
    accDescr: DER derivado por AST de todos los modelos con __tablename__, incluidas tablas de seguridad. PK, FK y UK simples corresponden al código; índices parciales, CHECK y restricciones compuestas se explican en el diccionario de datos. Nullable es opcionalidad de columna, no del proceso de negocio.
    direction LR
    rental_rates {
        uuid id PK
        uuid product_id FK
        str unit
        int price
    }
    rental_units {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid product_id FK
        uuid branch_id FK
        str code UK
        str status
        bool is_demo
        str usage_unit
        Decimal usage_value
        int service_threshold
        int service_interval_days
        datetime last_service_at
    }
    maintenance_logs {
        uuid id PK
        uuid unit_id FK
        str kind
        Decimal usage_delta "nullable"
        Decimal usage_after
        str note "nullable"
        uuid user_id FK "nullable"
        datetime created_at
    }
    rentals {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid user_id FK
        uuid product_id FK
        uuid branch_id FK
        uuid rental_unit_id FK "nullable"
        datetime start_at
        datetime end_at
        tstzrange period
        str status
        int price
        datetime payment_expires_at "nullable"
        str contact_name "nullable"
        str contact_email "nullable"
        str contact_phone "nullable"
        str document_type "nullable"
        str document_number "nullable"
        datetime checked_out_at "nullable"
        uuid checked_out_by FK "nullable"
        datetime returned_at "nullable"
        uuid returned_by FK "nullable"
        Decimal return_usage "nullable"
    }
    users {
        uuid id PK
        datetime created_at
        datetime updated_at
        str email UK
        str password_hash
        str first_name
        str last_name
        str phone
        str document_number "nullable"
        bool is_active
        bool is_admin
    }
    user_sessions {
        uuid id PK
        uuid user_id FK
        str token_hash UK
        str csrf_token_hash
        datetime expires_at
        datetime created_at
    }
    password_reset_tokens {
        uuid id PK
        uuid user_id FK
        str token_hash UK
        datetime expires_at
        datetime used_at "nullable"
        datetime created_at
    }
    login_attempts {
        uuid id PK
        str email_hash
        str ip_address
        bool succeeded
        datetime created_at
    }
    consent_records {
        uuid id PK
        uuid user_id FK
        str purpose
        str policy_version
        uuid order_id FK "nullable"
        uuid rental_id FK "nullable"
        datetime accepted_at
    }
    carts {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid user_id FK
        str status
    }
    cart_items {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid cart_id FK
        uuid product_id FK
        int quantity
        int unit_price
    }
    categories {
        uuid id PK
        str name UK
        str slug UK
        str description
    }
    products {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid category_id FK
        str name
        str slug UK
        str sku UK
        str short_description
        str description
        str brand
        int price
        int compare_at_price "nullable"
        json specifications
        json highlights
        str image_url "nullable"
        bool is_featured
        bool is_active
    }
    contact_messages {
        uuid id PK
        str full_name
        str email
        str phone "nullable"
        str topic
        str message
        str status
        str policy_version
        str ip_hash "nullable"
        datetime created_at
    }
    value_propositions {
        uuid id PK
        datetime created_at
        datetime updated_at
        str title
        str description
        str icon
        int position
        bool is_active
    }
    banners {
        uuid id PK
        datetime created_at
        datetime updated_at
        str title
        str description
        str cta_label
        str cta_href
        datetime starts_at
        datetime ends_at
        bool is_active
    }
    news_items {
        uuid id PK
        datetime created_at
        datetime updated_at
        str slug UK
        str title
        str excerpt
        datetime published_at
        bool is_published
    }
    couriers {
        uuid id PK
        datetime created_at
        datetime updated_at
        str name
        str phone
        bool is_active
    }
    deliveries {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid order_id FK
        uuid courier_id FK "nullable"
        str status
        str tracking_token UK
        str confirmation_code
        str proof_method "nullable"
        str signer_name "nullable"
        str signature_image "nullable"
        str failure_reason "nullable"
        datetime delivered_at "nullable"
        str carrier
        uuid drone_device_id FK "nullable"
        Decimal destination_latitude "nullable"
        Decimal destination_longitude "nullable"
        Decimal drop_latitude "nullable"
        Decimal drop_longitude "nullable"
        int drop_distance_m "nullable"
        datetime dropped_at "nullable"
        datetime customer_confirmed_at "nullable"
    }
    delivery_events {
        uuid id PK
        uuid delivery_id FK
        str status
        str note "nullable"
        uuid user_id FK "nullable"
        datetime created_at
    }
    inventory {
        uuid id PK
        uuid product_id FK
        uuid branch_id FK
        int available_quantity
        int reserved_quantity
        int total_quantity
        datetime updated_at
    }
    inventory_movements {
        uuid id PK
        uuid inventory_id FK
        str kind
        int quantity
        int balance_after
        str reason "nullable"
        uuid order_id FK "nullable"
        uuid user_id FK "nullable"
        datetime created_at
    }
    cart_reservations {
        uuid id PK
        uuid cart_item_id FK
        uuid inventory_id FK
        int quantity
        datetime expires_at
        datetime created_at
    }
    payments {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid user_id FK
        uuid order_id FK "nullable"
        uuid rental_id FK "nullable"
        str provider
        str reference UK
        int amount_in_cents
        str currency
        str status
        str provider_transaction_id UK "nullable"
        str payment_method_type "nullable"
        str status_message "nullable"
        bool requires_refund
        datetime approved_at "nullable"
    }
    payment_events {
        uuid id PK
        str checksum UK
        str event
        str transaction_id "nullable"
        str status "nullable"
        json payload
        datetime received_at
    }
    invoices {
        uuid id PK
        int number UK
        str prefix
        uuid payment_id FK
        uuid order_id FK "nullable"
        uuid rental_id FK "nullable"
        uuid user_id FK
        str buyer_name
        str buyer_document_type
        str buyer_document_number
        str buyer_email
        int subtotal
        int vat
        int total
        bytes pdf
        str xml
        datetime issued_at
    }
    refund_requests {
        uuid id PK
        uuid user_id FK
        uuid order_id FK "nullable"
        uuid rental_id FK "nullable"
        str reason
        str status
        datetime created_at
        datetime resolved_at "nullable"
    }
    orders {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid user_id FK
        str status
        int subtotal
        int shipping_cost
        int total
        uuid branch_id FK
        str fulfillment_method
        str delivery_address "nullable"
        str delivery_city "nullable"
        date scheduled_date
        str time_slot
        str payment_method "nullable"
        datetime payment_expires_at "nullable"
        datetime stock_settled_at "nullable"
        str contact_name
        str contact_email
        str contact_phone
        str document_type
        str document_number
    }
    order_items {
        uuid id PK
        uuid order_id FK
        uuid product_id FK
        int quantity
        int unit_price
        int subtotal
    }
    branches {
        uuid id PK
        datetime created_at
        datetime updated_at
        str slug UK
        str name
        str address
        str neighborhood
        str city
        str phone
        Decimal latitude
        Decimal longitude
        geography location
        json opening_hours
        json services
        int slot_capacity
        bool is_demo
        bool is_active
    }
    gps_devices {
        uuid id PK
        datetime created_at
        datetime updated_at
        str code UK
        str kind
        str token_hash UK
        uuid branch_id FK "nullable"
        uuid courier_id FK "nullable"
        uuid rental_unit_id FK "nullable"
        bool is_active
        Decimal last_latitude "nullable"
        Decimal last_longitude "nullable"
        int last_battery_pct "nullable"
        datetime last_seen_at "nullable"
    }
    gps_positions {
        uuid id PK
        uuid device_id FK
        Decimal latitude
        Decimal longitude
        int battery_pct "nullable"
        datetime recorded_at
    }
    geofences {
        uuid id PK
        datetime created_at
        datetime updated_at
        str name UK
        Decimal latitude
        Decimal longitude
        int radius_m
        bool is_active
        geography location
    }
    geofence_alerts {
        uuid id PK
        uuid device_id FK
        Decimal latitude
        Decimal longitude
        datetime opened_at
        datetime closed_at "nullable"
    }
    products ||--o{ rental_rates : "product_id"
    products ||--o{ rental_units : "product_id"
    branches ||--o{ rental_units : "branch_id"
    rental_units ||--o{ maintenance_logs : "unit_id"
    users |o--o{ maintenance_logs : "user_id"
    users ||--o{ rentals : "user_id"
    products ||--o{ rentals : "product_id"
    branches ||--o{ rentals : "branch_id"
    rental_units |o--o{ rentals : "rental_unit_id"
    users |o--o{ rentals : "checked_out_by"
    users |o--o{ rentals : "returned_by"
    users ||--o{ user_sessions : "user_id"
    users ||--o{ password_reset_tokens : "user_id"
    users ||--o{ consent_records : "user_id"
    orders |o--o{ consent_records : "order_id"
    rentals |o--o{ consent_records : "rental_id"
    users ||--o{ carts : "user_id"
