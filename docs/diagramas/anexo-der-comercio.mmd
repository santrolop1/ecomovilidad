erDiagram
    accTitle: DER ampliado: comercio
    accDescr: Vista parcial con atributos completos para facilitar lectura. Las relaciones entre dominios aparecen en el DER completo y en el diccionario de datos.
    direction LR
    users {
        uuid id PK
        datetime created_at
        datetime updated_at
        str email UK
        str password_hash
        str first_name
        str last_name
        str phone
        str document_number "nullable"
        bool is_active
        bool is_admin
    }
    categories {
        uuid id PK
        str name UK
        str slug UK
        str description
    }
    products {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid category_id FK
        str name
        str slug UK
        str sku UK
        str short_description
        str description
        str brand
        int price
        int compare_at_price "nullable"
        json specifications
        json highlights
        str image_url "nullable"
        bool is_featured
        bool is_active
    }
    branches {
        uuid id PK
        datetime created_at
        datetime updated_at
        str slug UK
        str name
        str address
        str neighborhood
        str city
        str phone
        Decimal latitude
        Decimal longitude
        geography location
        json opening_hours
        json services
        int slot_capacity
        bool is_demo
        bool is_active
    }
    inventory {
        uuid id PK
        uuid product_id FK
        uuid branch_id FK
        int available_quantity
        int reserved_quantity
        int total_quantity
        datetime updated_at
    }
    inventory_movements {
        uuid id PK
        uuid inventory_id FK
        str kind
        int quantity
        int balance_after
        str reason "nullable"
        uuid order_id FK "nullable"
        uuid user_id FK "nullable"
        datetime created_at
    }
    carts {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid user_id FK
        str status
    }
    cart_items {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid cart_id FK
        uuid product_id FK
        int quantity
        int unit_price
    }
    cart_reservations {
        uuid id PK
        uuid cart_item_id FK
        uuid inventory_id FK
        int quantity
        datetime expires_at
        datetime created_at
    }
    orders {
        uuid id PK
        datetime created_at
        datetime updated_at
        uuid user_id FK
        str status
        int subtotal
        int shipping_cost
        int total
        uuid branch_id FK
        str fulfillment_method
        str delivery_address "nullable"
        str delivery_city "nullable"
        date scheduled_date
        str time_slot
        str payment_method "nullable"
        datetime payment_expires_at "nullable"
        datetime stock_settled_at "nullable"
        str contact_name
        str contact_email
        str contact_phone
        str document_type
        str document_number
    }
    order_items {
        uuid id PK
        uuid order_id FK
        uuid product_id FK
        int quantity
        int unit_price
        int subtotal
    }
    categories ||--o{ products : "category_id"
    products ||--o{ inventory : "product_id"
    branches ||--o{ inventory : "branch_id"
    inventory ||--o{ inventory_movements : "inventory_id"
    orders |o--o{ inventory_movements : "order_id"
    users |o--o{ inventory_movements : "user_id"
    users ||--o{ carts : "user_id"
    carts ||--o{ cart_items : "cart_id"
    products ||--o{ cart_items : "product_id"
    cart_items ||--o{ cart_reservations : "cart_item_id"
    inventory ||--o{ cart_reservations : "inventory_id"
    users ||--o{ orders : "user_id"
    branches ||--o{ orders : "branch_id"
    orders ||--o{ order_items : "order_id"
    products ||--o{ order_items : "product_id"
