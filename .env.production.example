# Copia como .env.production en el servidor y completa. Ese archivo nunca va a Git.

# Dominio público, ya apuntando a este servidor.
DOMAIN=tienda.ejemplo.com
# Genera con: openssl rand -hex 24
POSTGRES_PASSWORD=

# Cobro. manual: el cliente paga por transferencia o contra entrega y el panel lo confirma.
# auto: Wompi, con sus cuatro llaves.
PAYMENT_PROVIDER=manual
# Obligatorio con el pago manual: cuenta, Nequi, punto de pago. Se muestra al cliente.
PAYMENT_INSTRUCTIONS=
# Minutos para pagar antes de que se libere lo apartado (máximo 1440).
PAYMENT_WINDOW_MINUTES=1440

# Solo con Wompi. Nunca en Git.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://production.wompi.co/v1

# Correo saliente (recuperar contraseñas y comprobantes).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Facturación.
COMPANY_NIT=
INVOICE_PREFIX=EMV

# true solo para cargar los datos de demostración.
SEED_DEMO=false
# Carpeta del servidor donde quedan las copias de la base de datos.
BACKUP_DIR=./backups
